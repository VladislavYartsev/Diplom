# Images (only for Option B: YCR prebuilt images)
# TASKFLOW_AI_IMAGE=cr.yandex/<registry-id>/taskflow-ai:latest
# TASKFLOW_WEB_IMAGE=cr.yandex/<registry-id>/taskflow-web:latest

# Postgres (in Docker)
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me

# Web app
AI_SERVICE_URL=http://taskflow-ai:8000
ConnectionStrings__DefaultConnection=Host=taskflow-db;Port=5432;Database=taskflow;Username=taskflow;Password=change_me

# AI service
REDIS_URL=redis://taskflow-redis:6379/0
# If you have a RuBERT model directory inside the container:
# RUBERT_MODEL_DIR=/app/models/rubert-priority

