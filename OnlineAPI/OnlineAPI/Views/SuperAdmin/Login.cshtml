@{
    ViewData["Title"] = "SuperAdmin Login";
    ViewData["AuthBodyClass"] = "auth-page auth-page--admin";
    Layout = "_AuthLayout";
}

<div class="auth-card auth-card--admin">
    <div class="auth-brand">
        <h1><i class="fas fa-shield-halved"></i> TaskFlow</h1>
    </div>

    <p class="auth-subtitle">Super Administrator Access</p>

    <form method="post" asp-action="Login" asp-controller="SuperAdmin">
        @Html.AntiForgeryToken()

        <div class="auth-form-group">
            <label class="auth-label" for="superadminLogin">Логин</label>
            <input id="superadminLogin" name="login" class="auth-input" placeholder="SuperAdmin login" required />
        </div>

        <div class="auth-form-group">
            <label class="auth-label" for="superadminPassword">Пароль</label>
            <input id="superadminPassword" name="password" type="password" class="auth-input" placeholder="Пароль" required />
        </div>

        <button type="submit" class="auth-button">Войти как SuperAdmin</button>

        @if (ViewBag.Error != null)
        {
            <div class="text-danger">@ViewBag.Error</div>
        }
    </form>

    <div class="auth-note">
        <strong>Внимание:</strong> доступ разрешен только супер-администраторам системы.
    </div>
</div>
