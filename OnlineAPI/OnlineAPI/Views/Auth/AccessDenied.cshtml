@{
    ViewData["Title"] = "Доступ запрещен";
    ViewData["AuthBodyClass"] = "auth-page auth-page--access";
    Layout = "_AuthLayout";
}

<div class="auth-card auth-card--glass">
    <div class="auth-icon-display">
        <i class="fas fa-ban"></i>
    </div>
    <h1 class="auth-title">Доступ запрещен</h1>
    <p class="auth-subtitle">У вас недостаточно прав для доступа к этой странице.</p>

    <div class="auth-actions">
        <a href="@Url.Action("Login", "Auth")" class="auth-button--light">Войти заново</a>
        <a href="@Url.Action("Index", "Projects")" class="auth-button--ghost">К проектам</a>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="auth-actions">
            <form method="post" asp-action="Logout" asp-controller="Auth">
                @Html.AntiForgeryToken()
                <button type="submit" class="auth-button">Выйти</button>
            </form>
        </div>
    }
</div>
