@{
    ViewData["Title"] = "Регистрация";
    ViewData["AuthBodyClass"] = "auth-page";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-brand">
        <h1><i class="fas fa-tasks"></i> TaskFlow</h1>
    </div>

    <h2 class="auth-title" id="title">Введите код приглашения</h2>

    <form id="codeForm">
        <div class="auth-form-group">
            <label class="auth-label" for="codeInput">Код приглашения</label>
            <input id="codeInput" class="auth-input" placeholder="Например: A8F3K9Q2" required />
        </div>

        <button class="auth-button" type="submit">Продолжить</button>
        <div id="codeError" class="text-danger"></div>
    </form>

    <form id="registerForm" method="post" action="/Auth/Register" style="display:none">
        <div class="auth-form-group">
            <label class="auth-label" for="registerLogin">Логин</label>
            <input id="registerLogin" name="login" class="auth-input" placeholder="Введите логин" required />
        </div>

        <div class="auth-form-group">
            <label class="auth-label" for="registerPassword">Пароль</label>
            <input id="registerPassword" name="password" type="password" class="auth-input" placeholder="Введите пароль" required />
        </div>

        <input type="hidden" name="code" id="hiddenCode" />
        <button class="auth-button" type="submit">Создать аккаунт</button>
    </form>

    <div class="auth-note">
        Регистрация возможна только по приглашению от администратора.
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("codeForm").addEventListener("submit", function (e) {
            e.preventDefault();

            const code = document.getElementById("codeInput").value;

            fetch("/Auth/CheckCode", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "code=" + encodeURIComponent(code)
            })
            .then(r => r.json())
            .then(d => {
                if (!d.success) {
                    document.getElementById("codeError").innerText = d.message;
                    return;
                }

                document.getElementById("title").innerText = "Регистрация";
                document.getElementById("codeForm").style.display = "none";
                document.getElementById("registerForm").style.display = "block";
                document.getElementById("hiddenCode").value = code;
            });
        });
    </script>
}
