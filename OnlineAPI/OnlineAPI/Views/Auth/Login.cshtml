@model OnlineAPI.Entities.LoginViewModel
@{
    ViewData["Title"] = "Авторизация";
    ViewData["AuthBodyClass"] = "auth-page";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-brand">
        <h1><i class="fas fa-tasks"></i> TaskFlow</h1>
    </div>

    <form method="post" asp-action="Login" asp-controller="Auth">
        @Html.AntiForgeryToken()

        @if (ViewData.ModelState.ContainsKey("") && ViewData.ModelState[""]!.Errors.Any())
        {
            <div class="auth-alert">
                <i class="fas fa-triangle-exclamation"></i>
                Неверный логин или пароль
            </div>
        }

        <div class="auth-form-group">
            <label asp-for="Username" class="auth-label">Имя пользователя</label>
            <input asp-for="Username" class="auth-input" placeholder="Введите имя пользователя" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="auth-form-group">
            <label asp-for="Password" class="auth-label">Пароль</label>
            <input asp-for="Password" type="password" class="auth-input" placeholder="Введите пароль" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="auth-checkbox">
            <input asp-for="RememberMe" type="checkbox" />
            <label asp-for="RememberMe">Запомнить меня</label>
        </div>

        <button type="submit" class="auth-button">Войти в систему</button>
    </form>

    <a href="@Url.Action("Register", "Auth")" class="auth-link-button">Регистрация по приглашению</a>

    <div class="auth-demo">
        <h4>Демо-аккаунты</h4>
        <p><strong>admin / admin123</strong> - Администратор</p>
        <p><strong>user / user123</strong> - Обычный пользователь</p>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
