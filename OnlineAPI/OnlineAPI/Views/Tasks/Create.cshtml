@model Entities.TaskCreateViewModel
@{
    ViewData["Title"] = "Создать задачу";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создать задачу - TaskFlow</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/taskboard.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <div class="logo">
                <h1><i class="fas fa-tasks"></i> <span>TaskFlow</span></h1>
            </div>
            <ul class="nav-menu">
                <li><a href="@Url.Action("Index", "Tasks", new { projectId = ViewBag.ProjectId })"><i class="fas fa-th-large"></i> <span>Доска</span></a></li>
                <li><a href="@Url.Action("Create", "Tasks", new { projectId = ViewBag.ProjectId })" class="active"><i class="fas fa-plus"></i> <span>Создать задачу</span></a></li>
            </ul>
        </div>

        <div class="main-content">
            <div class="top-bar">
                <div class="user-actions">
                    <div class="user-dropdown">
                        <div class="dropdown-toggle">
                            <div class="avatar">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    @((User.FindFirst("DisplayName")?.Value ?? User.Identity.Name)?[0].ToString().ToUpper())
                                }
                                else
                                {
                                    @:U
                                }
                            </div>
                            <i class="fas fa-chevron-down" style="font-size: 12px; color: #6b778c;"></i>
                        </div>
                        <div class="dropdown-menu">
                            <div class="user-info">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <div class="user-name">@(User.FindFirst("DisplayName")?.Value ?? User.Identity.Name)</div>
                                    <div class="user-role">Пользователь</div>
                                }
                                else
                                {
                                    <div class="user-name">Гость</div>
                                    <div class="user-role">Не авторизован</div>
                                }
                            </div>

                            @if (User.Identity.IsAuthenticated)
                            {
                                <a href="@Url.Action("Index", "Profile")" class="dropdown-item">
                                    <i class="fas fa-user"></i>
                                    <span>Мой профиль</span>
                                </a>
                                <a href="@Url.Action("Edit", "Profile")" class="dropdown-item">
                                    <i class="fas fa-edit"></i>
                                    <span>Редактировать профиль</span>
                                </a>
                                <div class="dropdown-divider"></div>
                                <form method="post" asp-action="Logout" asp-controller="Auth" class="dropdown-item-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span>Выйти</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Auth")" class="dropdown-item">
                                    <i class="fas fa-sign-in-alt"></i>
                                    <span>Войти</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="create-project-container">
                <div class="board-header">
                    <div class="board-title">
                        <h2>Создание новой задачи</h2>
                    </div>
                    <div class="board-actions">
                        <a href="@Url.Action("Index", "Tasks", new { projectId = ViewBag.ProjectId })" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Назад к доске</a>
                    </div>
                </div>

                <form method="post" asp-action="Create" asp-controller="Tasks" class="task-form">
                    @Html.AntiForgeryToken()

                    <div class="form-section">
                        <div class="form-group">
                            <label asp-for="Title">Название задачи *</label>
                            <input asp-for="Title" id="taskTitle" class="form-control" placeholder="Введите название задачи"/>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description">Описание</label>
                            <textarea asp-for="Description" class="form-control" placeholder="Опишите детали задачи" id="taskDescription"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Priority">Приоритет (AI Suggest)</label>
                            <div class="ai-select-wrap">
                                <select asp-for="Priority" class="form-control" asp-items="Html.GetEnumSelectList<OnlineAPI.Entities.TaskPriority>()" id="taskPriority">
                                </select>
                                <span id="priorityLoading" class="loading">AI думает...</span>
                            </div>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Исполнители</label>
                            <div class="user-select-list">
                                @foreach (var user in Model.AvailableUsers)
                                {
                                    <label class="user-select-item" for="user_@user.Value">
                                        <input class="user-select-input"
                                               type="checkbox"
                                               name="SelectedUsers"
                                               value="@user.Value"
                                               id="user_@user.Value">
                                        <span class="user-select-name">@user.Text</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <input type="hidden" asp-for="ProjectID" value="@ViewBag.ProjectId" />

                        <div class="form-actions">
                            <a href="@Url.Action("Index", "Tasks", new { projectId = ViewBag.ProjectId })" class="btn btn-outline">Отмена</a>
                            <button type="submit" class="btn btn-primary">Создать задачу</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Debounce функция, чтобы не отправлять слишком часто запросы
        function debounce(func, wait) {
            let timeout;
            return function() {
                const context = this, args = arguments;
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(context, args), wait);
            };
        }

        // Маппинг AI-строки в числовое значение enum
        function mapPriorityToValue(priorityStr) {
            switch(priorityStr) {
                case "Low": return "0";
                case "Medium": return "1";
                case "High": return "2";
                default: return "";
            }
        }

        function predictPriority() {
            var title = $("#taskTitle").val().trim();
            var description = $("#taskDescription").val().trim();

            if (!title && !description) return;

            $("#priorityLoading").show(); 

            $.ajax({
                url: "http://localhost:8000/predict",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ title: title, description: description }),
                success: function(response) {
                    var taskId = response.task_id;

                    // Polling для получения результата
                    var interval = setInterval(function() {
                        $.getJSON(`http://localhost:8000/predict/${taskId}`, function(result) {
                            if (result.priority) {
                                $("#taskPriority").val(mapPriorityToValue(result.priority));
                                $("#priorityLoading").hide();
                                clearInterval(interval);
                            }
                        }).fail(function(err) {
                            console.error("Ошибка получения AI результата:", err);
                            $("#priorityLoading").hide();
                            clearInterval(interval);
                        });
                    }, 1000);
                },
                error: function(err) {
                    console.error("Ошибка AI prediction:", err);
                    $("#priorityLoading").hide();
                }
            });
        }

        // Вешаем на ввод с дебаунсом 800ms
        $("#taskTitle, #taskDescription").on("input", debounce(predictPriority, 800));
    </script>
</body>
</html>
