@model Entities.TaskCreateViewModel
@{
    ViewData["Title"] = "Создать задачу";
    Layout = "_TaskFlowLayout";
}

@section Sidebar {
    <ul class="nav-menu">
        <li><a href="@Url.Action("Index", "Tasks", new { projectId = ViewBag.ProjectId })"><i class="fas fa-th-large"></i> <span>Доска</span></a></li>
        <li><a href="@Url.Action("Create", "Tasks", new { projectId = ViewBag.ProjectId })" class="active"><i class="fas fa-plus"></i> <span>Создать задачу</span></a></li>
    </ul>
}

<div class="create-project-container">
    <div class="board-header">
        <div class="board-title">
            <h2>Создание новой задачи</h2>
        </div>
        <div class="board-actions">
            <a href="@Url.Action("Index", "Tasks", new { projectId = ViewBag.ProjectId })" class="btn btn-outline">
                <i class="fas fa-arrow-left"></i> Назад к доске
            </a>
        </div>
    </div>

    <form method="post" asp-action="Create" asp-controller="Tasks" class="task-form">
        @Html.AntiForgeryToken()

        <div class="form-section">
            <div class="form-group">
                <label asp-for="Title">Название задачи *</label>
                <input asp-for="Title" id="taskTitle" class="form-control" placeholder="Введите название задачи" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" class="form-control" placeholder="Опишите детали задачи" id="taskDescription"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Priority">Приоритет (AI-подсказка)</label>
                <div class="ai-select-wrap">
                    <select asp-for="Priority" class="form-control" asp-items="Html.GetEnumSelectList<OnlineAPI.Entities.TaskPriority>()" id="taskPriority"></select>
                    <span id="priorityLoading" class="loading">AI думает...</span>
                </div>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Deadline">Дедлайн</label>
                <input asp-for="Deadline" type="datetime-local" class="form-control" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Исполнители</label>
                <div class="user-select-list">
                    @foreach (var user in Model.AvailableUsers)
                    {
                        <label class="user-select-item" for="user_@user.Value">
                            <input class="user-select-input"
                                   type="checkbox"
                                   name="SelectedUsers"
                                   value="@user.Value"
                                   id="user_@user.Value">
                            <span class="user-select-name">@user.Text</span>
                        </label>
                    }
                </div>
            </div>

            <input type="hidden" asp-for="ProjectID" value="@ViewBag.ProjectId" />

            <div class="form-actions">
                <a href="@Url.Action("Index", "Tasks", new { projectId = ViewBag.ProjectId })" class="btn btn-outline">Отмена</a>
                <button type="submit" class="btn btn-primary">Создать задачу</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const aiServiceUrl = `${window.location.protocol}//${window.location.hostname}:8001`;

        function debounce(func, wait) {
            let timeout;
            return function () {
                const context = this;
                const args = arguments;
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(context, args), wait);
            };
        }

        function mapPriorityToValue(priorityStr) {
            switch (priorityStr) {
                case "Low": return "0";
                case "Medium": return "1";
                case "High": return "2";
                default: return "";
            }
        }

        function predictPriority() {
            const title = $("#taskTitle").val().trim();
            const description = $("#taskDescription").val().trim();

            if (!title && !description) {
                return;
            }

            $("#priorityLoading").show();

            $.ajax({
                url: `${aiServiceUrl}/predict`,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ title: title, description: description }),
                success: function (response) {
                    const taskId = response.task_id;

                    const interval = setInterval(function () {
                        $.getJSON(`${aiServiceUrl}/predict/${taskId}`, function (result) {
                            if (result.priority) {
                                $("#taskPriority").val(mapPriorityToValue(result.priority));
                                $("#priorityLoading").hide();
                                clearInterval(interval);
                            }
                        }).fail(function (err) {
                            console.error("Ошибка получения AI-результата:", err);
                            $("#priorityLoading").hide();
                            clearInterval(interval);
                        });
                    }, 1000);
                },
                error: function (err) {
                    console.error("Ошибка AI-предсказания:", err);
                    $("#priorityLoading").hide();
                }
            });
        }

        $("#taskTitle, #taskDescription").on("input", debounce(predictPriority, 800));
    </script>
}
