@model OnlineAPI.Entities.ProjectSettingsViewModel
@{
    ViewData["Title"] = "Настройки проекта";
    Layout = "_TaskFlowLayout";
}

@functions {
    private string GetRoleLabel(string role)
    {
        return role switch
        {
            "Owner" => "Владелец",
            "Admin" => "Администратор",
            "Viewer" => "Просмотр",
            _ => "Участник"
        };
    }
}

@section Sidebar {
    <ul class="nav-menu">
        <li><a href="@Url.Action("Index", "Projects")"><i class="fas fa-layer-group"></i> <span>Проекты</span></a></li>
        <li><a href="@Url.Action("Index", "Tasks", new { projectId = Model.Id })"><i class="fas fa-list-check"></i> <span>Доска</span></a></li>
        <li><a href="@Url.Action("Index", "Reports", new { projectId = Model.Id })"><i class="fas fa-chart-pie"></i> <span>Отчеты</span></a></li>
        <li><a href="@Url.Action("Index", "ProjectSettings", new { projectId = Model.Id })" class="active"><i class="fas fa-cog"></i> <span>Настройки</span></a></li>
    </ul>
}

<div class="settings-container">
    <div class="reports-header">
        <div>
            <h2>Настройки проекта</h2>
            <p class="page-subtitle">Управление основными настройками и участниками проекта</p>
        </div>
        <div class="board-actions">
            <a href="@Url.Action("Index", "Tasks", new { projectId = Model.Id })" class="btn btn-outline">
                <i class="fas fa-arrow-left"></i> Назад к задачам
            </a>
        </div>
    </div>

    @if (!Model.CanEdit)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <strong>Режим просмотра:</strong> Вы можете только просматривать настройки. Для внесения изменений обратитесь к владельцу проекта.
        </div>
    }

    <div class="settings-section">
        <div class="section-header">
            <div class="section-title">
                <i class="fas fa-sliders-h"></i>
                <span>Основные настройки</span>
            </div>
        </div>

        <form id="projectForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.Id" />

            <div class="form-group">
                <label>Название проекта</label>
                @if (Model.CanEdit)
                {
                    <input type="text" name="Name" class="form-control" value="@Model.Name" />
                    <span class="text-danger" id="nameError"></span>
                }
                else
                {
                    <div class="readonly-field">@Model.Name</div>
                }
            </div>

            <div class="form-group">
                <label>Описание проекта</label>
                @if (Model.CanEdit)
                {
                    <textarea name="Description" class="form-control" rows="4">@Model.Description</textarea>
                    <span class="text-danger" id="descriptionError"></span>
                }
                else
                {
                    <div class="readonly-field">@(string.IsNullOrEmpty(Model.Description) ? "Описание отсутствует" : Model.Description)</div>
                }
            </div>

            @if (Model.CanEdit)
            {
                <div class="form-actions">
                    <button type="button" class="btn btn-outline" onclick="resetForm()">Отмена</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Сохранить изменения
                    </button>
                </div>
            }
        </form>
    </div>

    <div class="settings-section">
        <div class="section-header">
            <div class="section-title">
                <i class="fas fa-users"></i>
                <span>Участники проекта</span>
            </div>
            <span class="text-muted">@Model.Members.Count участников</span>
        </div>

        <div class="settings-subsection" style="margin-bottom: 20px;">
            <h4 style="margin-bottom: 15px;">Добавить участника</h4>

            <form id="addMemberForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProjectId" value="@Model.Id" />

                <div class="form-group" style="margin-bottom: 10px;">
                    <label>Login пользователя</label>
                    <input type="text" name="Login" class="form-control" placeholder="Введите login пользователя" required />
                </div>

                <div class="form-group" style="margin-bottom: 10px;">
                    <label>Роль</label>
                    <select name="Role" class="form-control role-select" required>
                        <option value="Member">Участник</option>
                        <option value="Admin">Администратор</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-user-plus"></i> Добавить в проект
                </button>
            </form>
        </div>

        <div class="members-list">
            @foreach (var member in Model.Members)
            {
                <div class="member-item">
                    <div class="member-info">
                        <div class="member-avatar">
                            @(member.UserName?[0].ToString().ToUpper() ?? "?")
                        </div>
                        <div class="member-details">
                            <div class="member-name">@member.UserName</div>
                        </div>
                    </div>

                    <div class="member-role">
                        @if (member.CanChangeRole)
                        {
                            <select class="form-control role-select" onchange="updateMemberRole('@member.UserId', this.value)">
                                <option value="Member" selected="@(member.Role == "Member")">Участник</option>
                                <option value="Admin" selected="@(member.Role == "Admin")">Администратор</option>
                            </select>
                            <button type="button" class="btn-icon btn-remove" onclick="removeMember('@member.UserId')" title="Удалить из проекта">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                        else
                        {
                            <span class="role-badge @($"role-{member.Role.ToLower()}")">
                                @switch (member.Role)
                                {
                                    case "Owner":
                                        <span><i class="fas fa-crown"></i> @GetRoleLabel(member.Role)</span>
                                        break;
                                    case "Admin":
                                        <span><i class="fas fa-shield-alt"></i> @GetRoleLabel(member.Role)</span>
                                        break;
                                    case "Viewer":
                                        <span><i class="fas fa-eye"></i> @GetRoleLabel(member.Role)</span>
                                        break;
                                    default:
                                        <span><i class="fas fa-user"></i> @GetRoleLabel(member.Role)</span>
                                        break;
                                }
                            </span>
                            @if (member.IsCurrentUser)
                            {
                                <span class="text-muted">(Вы)</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $('#projectForm').on('submit', function (e) {
            e.preventDefault();

            const formData = {
                ProjectId: $('input[name="ProjectId"]').val(),
                Name: $('input[name="Name"]').val(),
                Description: $('textarea[name="Description"]').val()
            };

            $.ajax({
                url: '@Url.Action("UpdateProject", "ProjectSettings")',
                type: 'POST',
                data: formData,
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.message);
                    } else {
                        showAlert('error', response.message);
                    }
                },
                error: function () {
                    showAlert('error', 'Произошла ошибка при сохранении');
                }
            });
        });

        $('#addMemberForm').on('submit', function (e) {
            e.preventDefault();

            const form = $(this);
            const formData = {
                ProjectId: form.find('input[name="ProjectId"]').val(),
                Login: form.find('input[name="Login"]').val(),
                Role: form.find('select[name="Role"]').val()
            };

            $.ajax({
                url: '@Url.Action("AddMember", "ProjectSettings")',
                type: 'POST',
                data: formData,
                headers: {
                    'RequestVerificationToken': form.find('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        form[0].reset();
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showAlert('error', response.message);
                    }
                },
                error: function () {
                    showAlert('error', 'Произошла ошибка при добавлении участника');
                }
            });
        });

        function updateMemberRole(userId, newRole) {
            if (!confirm('Вы уверены, что хотите изменить роль участника?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("UpdateMemberRole", "ProjectSettings")',
                type: 'POST',
                data: {
                    ProjectId: @Model.Id,
                    UserId: userId,
                    NewRole: newRole
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showAlert('error', response.message);
                    }
                },
                error: function () {
                    showAlert('error', 'Произошла ошибка при обновлении роли');
                }
            });
        }

        function removeMember(userId) {
            if (!confirm('Вы уверены, что хотите удалить участника из проекта?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("RemoveMember", "ProjectSettings")',
                type: 'POST',
                data: {
                    ProjectId: @Model.Id,
                    UserId: userId
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showAlert('error', response.message);
                    }
                },
                error: function () {
                    showAlert('error', 'Произошла ошибка при удалении участника');
                }
            });
        }

        function resetForm() {
            document.getElementById('projectForm').reset();
        }

        function showAlert(type, message) {
            const alert = document.createElement('div');
            alert.className = `alert alert-${type === 'success' ? 'success' : 'danger'}`;
            alert.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check' : 'exclamation'}-circle"></i>
                ${message}
                <button type="button" class="btn-close" onclick="this.parentElement.remove()" style="float: right; background: none; border: none; font-size: 16px;">
                    <i class="fas fa-times"></i>
                </button>
            `;

            const container = document.querySelector('.settings-container');
            container.insertBefore(alert, container.firstChild);

            setTimeout(() => {
                if (alert.parentElement) {
                    alert.remove();
                }
            }, 5000);
        }
    </script>
}
